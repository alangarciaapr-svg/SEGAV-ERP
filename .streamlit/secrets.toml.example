# SEGAV ERP local/Streamlit secrets example.
# Copy this file to .streamlit/secrets.toml and fill the values you need.

# Local fallback:
SEGAV_DB_BACKEND = "sqlite"

# Production/Supabase Postgres:
# SEGAV_DB_BACKEND = "postgres"
# SUPABASE_DB_URL = "postgresql://user:password@host:5432/dbname"
# SUPABASE_DB_HOST = "db.example.supabase.co"
# SUPABASE_DB_PORT = "5432"
# SUPABASE_DB_NAME = "postgres"
# SUPABASE_DB_USER = "postgres"
# SUPABASE_DB_PASSWORD = "change-me"

# Supabase Storage:
# SUPABASE_URL = "https://example.supabase.co"
# SUPABASE_STORAGE_BUCKET = "segav"
# SUPABASE_SERVICE_ROLE_KEY = "change-me"
# SUPABASE_ANON_KEY = "change-me"

# Initial admin override:
# DEFAULT_ADMIN_USER = "a.garcia"
# DEFAULT_ADMIN_PASS = "225188"
